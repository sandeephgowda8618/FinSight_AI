# Local development placeholders only. Replace DATABASE_URL locally; never commit it.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/finsight
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_MINUTES=60
COOKIE_SECURE=false

# Generate a unique secret locally; do not commit the actual secret.
# Example: python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_THROTTLE_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_BLOCK_SECONDS=900

# MFA secret storage — DEVELOPMENT ONLY.
# Generate a fresh 32-byte key; never commit the generated key.
# Example: python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# MFA_SECRET_STORE_BACKEND=dev-encrypted
# MFA_DEV_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# MFA_SECRET_STORE_PATH=<private-local-path-outside-the-repository>
#
# Production MFA is not supported by the current secret-store selector.
# Do not use the development encrypted-file backend in production.
